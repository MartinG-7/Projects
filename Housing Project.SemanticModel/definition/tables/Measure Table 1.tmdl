table 'Measure Table 1'
	lineageTag: af8fa54b-f331-4733-864d-5f958f7f3799

	measure 'Median Sales Price Change' = ```
			
			VAR CurrMedianPrice = 
			MEDIANX(FILTER('Housing',
			YEAR('Housing'[date].[Date])=
			YEAR(MAX('Housing'[date].[Date]))),'Housing'[purchase_price])
			
			VAR PrevMedianPrice = 
			MEDIANX(FILTER('Housing',
			YEAR('Housing'[date].[Date])=
			YEAR(MAX('Housing'[date].[Date]))-1),'Housing'[purchase_price])
			
			RETURN
			IF(PrevMedianPrice<>0,
			(CurrMedianPrice-PrevMedianPrice)/PrevMedianPrice,BLANK())
			```
		lineageTag: b3b72b77-7b23-459e-a115-538ec147c085

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YOY_Sales_Growth = ```
			
			var CurrYearSales =
			CALCULATE(SUM('Housing'[purchase_price]),
			YEAR('Housing'[date])=YEAR(MAX('Housing'[date])))
			
			VAR PrevYearSales = 
			CALCULATE(SUM('Housing'[purchase_price]),
			YEAR('Housing'[date])=YEAR(MAX('Housing'[date]))-1)
			
			RETURN
			IF(PrevYearSales<>0,(CurrYearSales-PrevYearSales)/PrevYearSales,BLANK())
			
			```
		lineageTag: a68c6c2c-b712-47cf-b4b8-a60a48d42c0a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Units Sold In Latest Year & Quarter' =
			
			CALCULATE(DISTINCTCOUNT('Housing'[house_id]),
			YEAR('Housing'[date])=YEAR(MAX('Housing'[date]))&& QUARTER('Housing'[date])=QUARTER(MAX('Housing'[date])))
		formatString: 0
		lineageTag: 95d59dbc-0133-4385-b494-ab2b4b2ac16f

	measure 'Last 12 Month Sales' = CALCULATE(SUM('Housing'[purchase_price]),DATESINPERIOD('Housing'[date],MAX('Housing'[date]),-12,MONTH))
		formatString: 0
		lineageTag: d2e86085-97f0-4495-a510-ea6645acc109

	partition 'Measure Table 1' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	changedProperty = Name

	annotation PBI_ResultType = Table

