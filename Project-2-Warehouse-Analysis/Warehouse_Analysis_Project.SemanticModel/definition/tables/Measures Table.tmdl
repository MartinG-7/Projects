table 'Measures Table'
	lineageTag: b4dea694-69fb-4f98-b322-57ac93661ae3

	measure 'Total Number Of Days' = DISTINCTCOUNT('Demand/Availability Data'[Order_Date_DD_MM_YYYY].[Date])
		formatString: 0
		lineageTag: 24d23f27-19d9-4aaf-912b-8fbdbc053943

	measure 'Total Demand' = SUM('Demand/Availability Data'[Demand])
		formatString: 0
		lineageTag: f2ebdec8-95a0-484a-8380-d4d8f6a9df11

	measure 'Total Availability' = SUM('Demand/Availability Data'[Availability])
		formatString: 0
		lineageTag: 6fae8d56-ba04-434a-a8d2-0b9b1ab3ca86

	measure 'Average Demand Per Day' = DIVIDE('Measures Table'[Total Demand],'Measures Table'[Total Number Of Days])
		lineageTag: 0fdc24b4-f98f-4a7a-9c09-c6f8ba705c00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Availability' = DIVIDE('Measures Table'[Total Availability],'Measures Table'[Total Number Of Days])
		lineageTag: 3e8cf928-fc87-4c8e-90a7-44d3bcfd1077

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Supply Shortage' = 'Measures Table'[Total Demand]-'Measures Table'[Total Availability]
		formatString: 0
		lineageTag: 7420898e-247c-4ea9-b117-0302fb05eaa2

	measure 'Total Loss' = SUMX(FILTER('Demand/Availability Data','Demand/Availability Data'[Loss/Profit]<0),'Demand/Availability Data'[Loss/Profit]*'Demand/Availability Data'[Unit_Price]) * -1
		formatString: 0
		lineageTag: d2b4027f-c486-41bc-9bac-624f98d8c589

	measure 'Total Profit' = SUMX(FILTER('Demand/Availability Data','Demand/Availability Data'[Loss/Profit]>0),'Demand/Availability Data'[Loss/Profit]* 'Demand/Availability Data'[Unit_Price])
		formatString: 0
		lineageTag: 0a23d7b6-9bb7-4fbc-823e-9f125aed01e4

	measure 'Average Loss Per Day' = DIVIDE('Measures Table'[Total Loss],'Measures Table'[Total Number Of Days])
		lineageTag: ec700f21-d9a4-4f74-aede-1eb517e981ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Measures Table' = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

